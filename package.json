{
  "name": "kin",
  "private": true,
  "version": "0.1.0",
  "description": "Care coordination for families looking after a relative",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "test": "npm run test --workspace=server",
    "build": "npm run build --workspace=client",
    "mongo:start": "mongod --dbpath .data/mongo --port 27017 --bind_ip 127.0.0.1 --logpath .data/mongod.log --fork",
    "mongo:stop": "pkill -x mongod"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
